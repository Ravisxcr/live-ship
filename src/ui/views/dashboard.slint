import { ScrollView } from "std-widgets.slint";
import { StatusBadge } from "../components/status_badge.slint";

export struct DeploymentCardData {
    id: string,
    name: string,
    app_type: string,
    work_dir: string,
    command: string,
    status_text: string,
    status_color: color,
    dot_color: color,
    is_running: bool,
}

export component DashboardView inherits Rectangle {
    in property <[DeploymentCardData]> deployments: [];

    callback start_app(string);
    callback stop_app(string);
    callback restart_app(string);
    callback view_logs(string);
    callback edit_app(string);
    callback create_new();

    background: #0B1120; // slate-950

    VerticalLayout {
        padding: 24px;
        spacing: 20px;

        // Header Title + Stats
        HorizontalLayout {
            alignment: space-between;

            VerticalLayout {
                spacing: 4px;

                Text {
                    text: "Deployments Dashboard";
                    font-size: 22px;
                    font-weight: 700;
                    color: #F8FAFC;
                }

                Text {
                    text: "Manage and monitor standalone FastAPI, Go binary, and React web applications";
                    font-size: 13px;
                    color: #94A3B8;
                }
            }

            Rectangle {
                width: 140px;
                height: 38px;
                border-radius: 6px;
                background: new_btn.has_hover ? #0284C7 : #0369A1;

                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;

                    Image {
                        source: @image-url("../../../assets/icons/plus.svg");
                        width: 14px;
                        height: 14px;
                        colorize: #FFFFFF;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "Add Deployment";
                        font-size: 12px;
                        font-weight: 600;
                        color: #FFFFFF;
                        vertical-alignment: center;
                    }
                }

                new_btn := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.create_new(); }
                }
            }
        }

        // Empty state if no deployments
        if root.deployments.length == 0: Rectangle {
            height: 200px;
            background: #0F172A;
            border-radius: 8px;
            border-width: 1px;
            border-color: #1E293B;

            VerticalLayout {
                alignment: center;
                spacing: 12px;

                Image {
                    source: @image-url("../../../assets/icons/rocket.svg");
                    width: 36px;
                    height: 36px;
                    colorize: #38BDF8;
                    x: (parent.width - self.width) / 2;
                }

                Text {
                    text: "No deployments created yet";
                    font-size: 16px;
                    font-weight: 600;
                    color: #E2E8F0;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Click '+ Add Deployment' above or in the sidebar to configure your first application.";
                    font-size: 13px;
                    color: #64748B;
                    horizontal-alignment: center;
                }
            }
        }

        // Deployment Cards List
        cards_scroll := ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                width: cards_scroll.visible-width;
                spacing: 12px;
                alignment: start;

                for card in root.deployments: Rectangle {
                    height: 110px;
                    border-radius: 8px;
                    background: #0F172A;
                    border-width: 1px;
                    border-color: card.is_running ? #10B981.with_alpha(0.4) : #1E293B;

                    HorizontalLayout {
                        padding: 16px;
                        spacing: 16px;
                        alignment: space-between;

                        // Left info block
                        VerticalLayout {
                            spacing: 6px;
                            horizontal-stretch: 1;

                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;

                                Text {
                                    text: card.name;
                                    font-size: 16px;
                                    font-weight: 700;
                                    color: #F8FAFC;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    border-radius: 4px;
                                    background: #1E293B;
                                    height: 20px;
                                    y: (parent.height - self.height) / 2;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;

                                        Text {
                                            text: card.app_type;
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: #38BDF8;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }

                                StatusBadge {
                                    status_text: card.status_text;
                                    badge_color: card.status_color;
                                    dot_color: card.dot_color;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            // Directory path
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                height: 16px;

                                Image {
                                    source: @image-url("../../../assets/icons/folder.svg");
                                    width: 13px;
                                    height: 13px;
                                    colorize: #64748B;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: "Path:";
                                    font-size: 11px;
                                    color: #64748B;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: card.work_dir != "" ? card.work_dir : "(default workspace)";
                                    font-size: 11px;
                                    color: #94A3B8;
                                    font-family: "Consolas, monospace";
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }

                            // Command
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                height: 16px;

                                Image {
                                    source: @image-url("../../../assets/icons/terminal.svg");
                                    width: 13px;
                                    height: 13px;
                                    colorize: #64748B;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: "Command:";
                                    font-size: 11px;
                                    color: #64748B;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: card.command;
                                    font-size: 11px;
                                    color: #CBD5E1;
                                    font-family: "Consolas, monospace";
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Right action buttons
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            y: (parent.height - self.height) / 2;

                            if !card.is_running: Rectangle {
                                width: 84px;
                                height: 32px;
                                border-radius: 5px;
                                background: start_touch.pressed ? #047857 : (start_touch.has_hover ? #059669 : #10B981);

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 5px;

                                    Image {
                                        source: @image-url("../../../assets/icons/play.svg");
                                        width: 11px;
                                        height: 11px;
                                        colorize: #FFFFFF;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    Text {
                                        text: "Start";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #FFFFFF;
                                        vertical-alignment: center;
                                    }
                                }

                                start_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.start_app(card.id); }
                                }
                            }

                            if card.is_running: Rectangle {
                                width: 84px;
                                height: 32px;
                                border-radius: 5px;
                                background: stop_touch.pressed ? #B91C1C : (stop_touch.has_hover ? #DC2626 : #EF4444);

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 5px;

                                    Image {
                                        source: @image-url("../../../assets/icons/stop.svg");
                                        width: 11px;
                                        height: 11px;
                                        colorize: #FFFFFF;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    Text {
                                        text: "Stop";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #FFFFFF;
                                        vertical-alignment: center;
                                    }
                                }

                                stop_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.stop_app(card.id); }
                                }
                            }

                            if card.is_running: Rectangle {
                                width: 88px;
                                height: 32px;
                                border-radius: 5px;
                                background: restart_touch.pressed ? #B45309 : (restart_touch.has_hover ? #D97706 : #F59E0B);

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 5px;

                                    Image {
                                        source: @image-url("../../../assets/icons/refresh.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: #FFFFFF;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    Text {
                                        text: "Restart";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: #FFFFFF;
                                        vertical-alignment: center;
                                    }
                                }

                                restart_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.restart_app(card.id); }
                                }
                            }

                            Rectangle {
                                width: 74px;
                                height: 32px;
                                border-radius: 5px;
                                background: logs_touch.pressed ? #1E293B : (logs_touch.has_hover ? #334155 : #1E293B);
                                border-width: 1px;
                                border-color: logs_touch.has_hover ? #475569 : #334155;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 5px;

                                    Image {
                                        source: @image-url("../../../assets/icons/file-text.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: logs_touch.has_hover ? #F8FAFC : #94A3B8;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    Text {
                                        text: "Logs";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: logs_touch.has_hover ? #F8FAFC : #94A3B8;
                                        vertical-alignment: center;
                                    }
                                }

                                logs_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.view_logs(card.id); }
                                }
                            }

                            Rectangle {
                                width: 68px;
                                height: 32px;
                                border-radius: 5px;
                                background: edit_touch.pressed ? #1E293B : (edit_touch.has_hover ? #334155 : #1E293B);
                                border-width: 1px;
                                border-color: edit_touch.has_hover ? #475569 : #334155;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 5px;

                                    Image {
                                        source: @image-url("../../../assets/icons/edit.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: edit_touch.has_hover ? #F8FAFC : #94A3B8;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    Text {
                                        text: "Edit";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: edit_touch.has_hover ? #F8FAFC : #94A3B8;
                                        vertical-alignment: center;
                                    }
                                }

                                edit_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.edit_app(card.id); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

