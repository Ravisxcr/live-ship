import { LineEdit, TextEdit, ScrollView } from "std-widgets.slint";

export component DeploymentDialog inherits Rectangle {
    in-out property <string> edit_id: "";
    in-out property <string> form_name: "";
    in-out property <string> form_type: "FastAPI (Python)";
    in-out property <string> form_work_dir: "";
    in-out property <string> form_command: "";
    in-out property <string> form_env_text: "";
    in-out property <bool> form_auto_restart: false;
    in property <bool> is_new: true;

    callback save(string, string, string, string, string, bool);
    callback cancel();
    callback delete_deployment(string);
    callback select_app_type(string);
    callback browse_work_dir();

    // Full screen overlay backdrop
    background: #000000B0; // dark transparent backdrop

    // Backdrop touch area (clicking outside modal closes it)
    backdrop_touch := TouchArea {
        clicked => { root.cancel(); }
    }

    // Modal Card Dialog Window
    modal_card := Rectangle {
        width: min(680px, root.width - 48px);
        height: min(640px, root.height - 48px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 12px;
        background: #0F172A; // slate-900
        border-width: 1px;
        border-color: #334155; // slate-700
        clip: true;

        // Block clicks from falling through to backdrop
        TouchArea {}

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Modal Header
            Rectangle {
                height: 64px;
                background: #0F172A;

                // 1px divider at bottom of header
                Rectangle {
                    height: 1px;
                    y: parent.height - 1px;
                    background: #1E293B;
                }

                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 18px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 3px;
                        alignment: center;

                        Text {
                            text: is_new ? "Create New Deployment" : "Edit Deployment Configuration";
                            font-size: 16px;
                            font-weight: 700;
                            color: #F8FAFC;
                        }

                        Text {
                            text: "Configure the working directory, execution command, and environment variables.";
                            font-size: 12px;
                            color: #94A3B8;
                        }
                    }

                    // Close "X" button
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 6px;
                        background: close_touch.pressed ? #334155 : (close_touch.has_hover ? #1E293B : transparent);
                        y: (parent.height - self.height) / 2;

                        close_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.cancel(); }
                        }

                        Image {
                            source: @image-url("../../../assets/icons/x.svg");
                            width: 14px;
                            height: 14px;
                            colorize: close_touch.has_hover ? #F8FAFC : #94A3B8;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }

            // Modal Body (Scrollable form content)
            form_scroll := ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    width: form_scroll.visible-width;
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 20px;
                    padding-bottom: 20px;
                    spacing: 18px;
                    alignment: start;

                    // Quick App Type Presets
                    VerticalLayout {
                        spacing: 8px;

                        Text {
                            text: "APPLICATION TYPE / PRESET";
                            font-size: 11px;
                            font-weight: 700;
                            color: #64748B;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            for type_name in ["FastAPI (Python)", "Go Binary", "React App", "Custom"]: Rectangle {
                                height: 34px;
                                border-radius: 6px;
                                background: form_type == type_name ? #0284C7 : (preset_touch.has_hover ? #1E293B : #0B1120);
                                border-width: 1px;
                                border-color: form_type == type_name ? #38BDF8 : #334155;

                                preset_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.select_app_type(type_name); }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: center;

                                    Text {
                                        text: type_name;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: form_type == type_name ? #FFFFFF : #CBD5E1;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Deployment Name
                    VerticalLayout {
                        spacing: 6px;

                        Text {
                            text: "DEPLOYMENT NAME";
                            font-size: 11px;
                            font-weight: 700;
                            color: #64748B;
                        }

                        LineEdit {
                            text <=> root.form_name;
                            placeholder-text: "e.g. FastAPI Auth Service, Go Payment Gateway, React Frontend";
                            height: 38px;
                        }
                    }

                    // Working Directory Path
                    VerticalLayout {
                        spacing: 6px;

                        HorizontalLayout {
                            alignment: space-between;

                            Text {
                                text: "WORKING DIRECTORY (TERMINAL PATH)";
                                font-size: 11px;
                                font-weight: 700;
                                color: #64748B;
                            }

                            Text {
                                text: "Path where terminal process will execute";
                                font-size: 11px;
                                color: #94A3B8;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.form_work_dir;
                                placeholder-text: "e.g. C:\\Projects\\my-fastapi-app or e:\\My Code\\react-dashboard";
                                height: 38px;
                            }

                            Rectangle {
                                width: 104px;
                                height: 38px;
                                border-radius: 6px;
                                background: browse_touch.has_hover ? #334155 : #1E293B;
                                border-width: 1px;
                                border-color: browse_touch.has_hover ? #475569 : #334155;

                                browse_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.browse_work_dir(); }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: center;
                                    spacing: 6px;

                                    Image {
                                        source: @image-url("../../../assets/icons/folder.svg");
                                        width: 14px;
                                        height: 14px;
                                        colorize: browse_touch.has_hover ? #F8FAFC : #94A3B8;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    Text {
                                        text: "Browse...";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: browse_touch.has_hover ? #F8FAFC : #CBD5E1;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Command Line
                    VerticalLayout {
                        spacing: 6px;

                        HorizontalLayout {
                            alignment: space-between;

                            Text {
                                text: "EXECUTION / START COMMAND";
                                font-size: 11px;
                                font-weight: 700;
                                color: #64748B;
                            }

                            Text {
                                text: "Supports flags and arguments";
                                font-size: 11px;
                                color: #94A3B8;
                            }
                        }

                        LineEdit {
                            text <=> root.form_command;
                            placeholder-text: "e.g. uvicorn main:app --reload --port 8000 OR go run . OR npm run dev";
                            height: 38px;
                        }
                    }

                    // Environment Variables Injection
                    VerticalLayout {
                        spacing: 6px;

                        HorizontalLayout {
                            alignment: space-between;

                            Text {
                                text: "ENVIRONMENT VARIABLES (.ENV FORMAT)";
                                font-size: 11px;
                                font-weight: 700;
                                color: #64748B;
                            }

                            Text {
                                text: "Injected directly into process terminal (KEY=VALUE per line)";
                                font-size: 11px;
                                color: #94A3B8;
                            }
                        }

                        TextEdit {
                            text <=> root.form_env_text;
                            height: 110px;
                            font-family: "Consolas, monospace";
                            font-size: 12px;
                        }
                    }

                    // Auto-Restart Option
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 4px;
                            background: root.form_auto_restart ? #0284C7 : #1E293B;
                            border-width: 1px;
                            border-color: #334155;
                            y: (parent.height - self.height) / 2;

                            check_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.form_auto_restart = !root.form_auto_restart; }
                            }

                            if root.form_auto_restart: Image {
                                source: @image-url("../../../assets/icons/check.svg");
                                width: 12px;
                                height: 12px;
                                colorize: #FFFFFF;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        Text {
                            text: "Auto-restart if process crashes or exits";
                            font-size: 12px;
                            color: #CBD5E1;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Modal Footer
            Rectangle {
                height: 60px;
                background: #0B1120; // slate-950

                // 1px divider at top of footer
                Rectangle {
                    height: 1px;
                    y: 0px;
                    background: #1E293B;
                }

                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    alignment: space-between;

                    // Left: Delete button if editing
                    HorizontalLayout {
                        alignment: start;
                        y: (parent.height - self.height) / 2;

                        if !is_new: Rectangle {
                            height: 36px;
                            border-radius: 6px;
                            background: del_touch.has_hover ? #991B1B : #7F1D1D;

                            del_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.delete_deployment(root.edit_id); }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                alignment: center;
                                spacing: 6px;

                                Image {
                                    source: @image-url("../../../assets/icons/trash.svg");
                                    width: 13px;
                                    height: 13px;
                                    colorize: #FCA5A5;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: "Delete Deployment";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: #FCA5A5;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Right: Cancel & Save Buttons
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: end;
                        y: (parent.height - self.height) / 2;

                        Rectangle {
                            width: 88px;
                            height: 36px;
                            border-radius: 6px;
                            background: cancel_touch.has_hover ? #334155 : #1E293B;
                            border-width: 1px;
                            border-color: #334155;

                            cancel_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.cancel(); }
                            }

                            Text {
                                text: "Cancel";
                                font-size: 12px;
                                font-weight: 600;
                                color: #94A3B8;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            width: 140px;
                            height: 36px;
                            border-radius: 6px;
                            background: save_touch.has_hover ? #0284C7 : #0369A1;

                            save_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.save(
                                        root.edit_id,
                                        root.form_name,
                                        root.form_type,
                                        root.form_work_dir,
                                        root.form_command,
                                        root.form_auto_restart
                                    );
                                }
                            }

                            Text {
                                text: is_new ? "Create Deployment" : "Save Changes";
                                font-size: 12px;
                                font-weight: 700;
                                color: #FFFFFF;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
